<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center">
    <h1>Found Pets</h1>
    <%= link_to new_pet_path, class: 'btn btn-info' do  %>
      <i class="fa-solid fa-plus"></i>
    <% end %>
  </div>
  <div class="cards">
    <% @pets.each do |pet| %>
      <div class="card-product position-relative">
        <%= image_tag "#{pet.species}.jpg", alt: pet.species %>
        <div class="card-product-infos">
          <h2><%= pet.name %></h2>
          <p><%= pet.location %></p>
          <p><%= pet.found_on.strftime('%A, %b %d') %></p>
        </div>
        <%= link_to "", pet_path(pet), class: 'w-100 h-100 position-absolute top-0 bottom-0 start-0'  %>
      </div>
    <% end %>
  </div>
</div>
