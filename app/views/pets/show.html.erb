<div class="container my-5">
  <div class="card-product">
    <%= image_tag "#{@pet.species}.jpg", alt: @pet.species %>
    <div class="card-product-infos">
      <h2><%= @pet.name %></h2>
      <p><%= @pet.location %></p>
      <p><%= @pet.found_on.strftime('%A, %b %d') %></p>
    </div>
  </div>
  <p class="mt-3">
    <%= link_to pets_path, class: 'btn btn-info' do %>
      <i class="fa-solid fa-paw"></i>
    <% end %>
    <%= link_to pet_path(@pet),
      data: { turbo_method: :delete, turbo_confirm: "Release #{@pet.name}?" },
      class: 'btn btn-danger' do %>
      <i class="fa-solid fa-person-through-window"></i>
    <% end %>
  </p>
</div>
